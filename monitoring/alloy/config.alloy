// ─────────────── LOGS: contenedores de docker → Loki ───────────────

discovery.docker "contenedores" {
  host = "unix:///var/run/docker.sock"
}

// Las etiquetas de Loki nacen aqui, no en la aplicacion: se derivan de los
// metadatos que docker expone de cada contenedor.
discovery.relabel "contenedores" {
  targets = discovery.docker.contenedores.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "contenedores" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.contenedores.output
  labels     = { job = "docker" }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ─────────────── TRAZAS: aplicacion → Tempo ───────────────

otelcol.receiver.otlp "entrada" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
