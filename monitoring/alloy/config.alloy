discovery.docker "contenedores" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "contenedores" {
  targets = discovery.docker.contenedores.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "contenedores" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.contenedores.output
  labels     = { job = "docker" }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "entrada" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [
      otelcol.connector.spanmetrics.default.input,
      otelcol.processor.batch.default.input,
    ]
  }
}

otelcol.connector.spanmetrics "default" {
  namespace = "traces.span.metrics"

  histogram {
    unit = "ms"

    explicit {
      buckets = ["5ms", "10ms", "25ms", "50ms", "100ms", "250ms", "500ms", "1s", "2.5s", "5s", "10s"]
    }
  }

  dimension {
    name = "http.route"
  }

  dimension {
    name = "http.request.method"
  }

  dimension {
    name = "http.response.status_code"
  }

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.relabel.spanmetrics.receiver]
}

prometheus.relabel "spanmetrics" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    source_labels = ["http_response_status_code"]
    target_label  = "http_status_code"
  }
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
