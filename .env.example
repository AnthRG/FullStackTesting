# Variables para docker-compose (todas opcionales, defaults de localhost)
# Copia este archivo a .env y edita lo que necesites: cp .env.example .env

# Con esto, "docker compose up -d" a secas ya arma el stack de desarrollo.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Sin este perfil quedan solo app + db + keycloak, sin Grafana ni Prometheus.
COMPOSE_PROFILES=observability
SPRING_PROFILES_ACTIVE=dev

# --- Puertos publicados en el host ---
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432

# --- Observabilidad ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_PORT=12345
METRICS_NAMESPACE=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317

# --- Base de datos ---
POSTGRES_DB=fullstacktesting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend ---
# URL JDBC que usa el backend. En compose el host es "db"; corriendo local usa localhost.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fullstacktesting
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (runtime) ---
# El entrypoint del contenedor las escribe en /config.js al arrancar, asi que la
# misma imagen sirve para cualquier entorno. Para "npm run dev" mandan las VITE_*
# de frontend/.env, no estas.
PUBLIC_API_URL=http://localhost:8080
PUBLIC_KEYCLOAK_URL=http://localhost:8081
PUBLIC_KEYCLOAK_REALM=fullstacktesting
PUBLIC_KEYCLOAK_CLIENT_ID=frontend
