# Produccion - 64.227.28.189
# Copiar a /srv/fullstacktesting/.env en el droplet, con chmod 600. No va al repo.
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

ENTORNO=prod
COMPOSE_PROJECT_NAME=fst-prod
COMPOSE_PROFILES=observability

# Lo escribe el workflow de deploy. Para promover, es el mismo sha que ya paso por staging.
IMAGE_TAG=CAMBIAME
GITHUB_REPOSITORY_OWNER=anthrg

# --- Base de datos ---
POSTGRES_DB=fullstacktesting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAME
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fullstacktesting
SPRING_DATASOURCE_USERNAME=postgres

# --- Backend ---
CORS_ALLOWED_ORIGINS=https://app.cloudsus.net
JWT_EXPECTED_AUDIENCE=fullstacktesting-api

KEYCLOAK_ISSUER_URI=https://auth.cloudsus.net/realms/fullstacktesting
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/fullstacktesting/protocol/openid-connect/certs
KEYCLOAK_LOGIN_TOKEN_URI=http://keycloak:8080/realms/fullstacktesting/protocol/openid-connect/token
KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080

# --- Keycloak ---
# realm-prod.json no trae usuarios semilla: el primer admin se crea a mano.
KEYCLOAK_PUBLIC_URL=https://auth.cloudsus.net
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAME

# --- Frontend (runtime, lo inyecta el entrypoint en /config.js) ---
PUBLIC_API_URL=https://api.cloudsus.net
PUBLIC_KEYCLOAK_URL=https://auth.cloudsus.net
PUBLIC_KEYCLOAK_REALM=fullstacktesting
PUBLIC_KEYCLOAK_CLIENT_ID=frontend

# --- Observabilidad ---
METRICS_NAMESPACE=prod
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAME
GRAFANA_ROOT_URL=https://grafana.cloudsus.net

# --- Cloudflare Tunnel ---
# El tunnel usa config versionada (cloudflared/config.prod.yml). Lo unico que
# falta en el droplet es cloudflared/credentials.json, que no va al repo.
CLOUDFLARED_VERSION=latest
