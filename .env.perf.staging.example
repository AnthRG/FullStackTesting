# Overrides opcionales de la suite de performance contra staging.
#
# No hace falta este archivo para correrla: scripts/perf-staging.sh ya apunta a staging
# y usa admin/admin, los usuarios semilla de keycloak/realm-staging.json. Copiarlo a
# .env.perf.staging (git lo ignora) solo si cambia alguna de estas cosas:
#
#   cp .env.perf.staging.example .env.perf.staging

# PERF_USERNAME=admin
# PERF_PASSWORD=admin

# PERF_BASE_URL=https://api-stg.cloudsus.net
# PERF_KEYCLOAK_URL=https://auth-stg.cloudsus.net

# PERF_VUS=20
# PERF_DURATION=2m
# PERF_STRESS_LEVELS=20,50,100,150
